# Copy this file to .env and fill in the values. Never commit .env.

# Google Drive API key (free). Create it in Google Cloud Console:
# APIs & Services > Library > enable "Google Drive API",
# then Credentials > Create credentials > API key (restrict it to the Drive API).
GOOGLE_API_KEY=

# Files larger than this are skipped with a clear error (in megabytes).
MAX_FILE_MB=25

# Maximum number of files accepted in one batch.
MAX_FILES_PER_BATCH=50

# Number of files processed in parallel (OCR is CPU-heavy, keep it small).
BATCH_WORKERS=2
